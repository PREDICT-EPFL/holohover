{
  "controller": "shot_mpc",

  "simulation": {
    "hz": 100,
    "physics_hz": 1000,
    "duration": 10,
    "u_limits": [0.35, 0.35, 0.005],
    "input_delay": 0,
    "opponent": "none"
  },

  "table": {
    "width": 2.13,
    "height": 1.06,
    "goal_width": 0.34,
    "friction": 0.3
  },

  "robot": {
    "radius": 0.07,
    "mass": 0.116,
    "robot1": {
      "defensive_position_rel": 0.85,
      "initial_position": [1.9, 0.85, 0.0],
      "initial_velocity": [0, 0, 0]
    },
    "robot2": {
      "defensive_position_rel": 0.15,
      "initial_position": [0.1, 0.9, 0.0],
      "initial_velocity": [0, 0, 0],
      "park": [0.08, 0.08]
    }
  },

  "puck": {
    "radius": 0.035,
    "mass": 0.023,
    "initial_position": [1.2, 0.53, 0.0],
    "initial_velocity": [0.0, 0.0, 0.0]
  },

  "scenarios": {
    "default": {},
    "stationary": {"robot1": [1.9, 0.85, 0.0, 0.0, 0.0, 0.0], "puck": [1.45, 0.40, 0.0, 0.0, 0.0, 0.0]},
    "incoming": {"robot1": [1.81, 0.53, 0.0, 0.0, 0.0, 0.0], "puck": [0.6, 0.75, 0.0, 1.0, -0.25, 0.0]},
    "around": {"robot1": [1.3, 0.50, 0.0, 0.0, 0.0, 0.0], "puck": [1.6, 0.55, 0.0, 0.0, 0.0, 0.0]}
  },

  "evaluation": {
    "duration": 4.0,
    "starts": "config/eval_starts.json",
    "sampling": {
      "robot1_jitter": 0.05,
      "stationary_fraction": 0.4,
      "puck_x_stationary": [1.2, 1.9],
      "puck_x_moving": [0.4, 1.6],
      "puck_y": [0.15, 0.91],
      "speed": [0.3, 1.2],
      "heading_deg": [-45, 45]
    }
  },

  "dial": {
    "path_planning_hz": 10,
    "H": 15,
    "n_knots": 5,
    "Nw": 2000,
    "N": 8,
    "update_temperature": 10,
    "beta1": 0.25,
    "beta2": 1,
    "path_planning_scale": [0.01, 0.01, 0.5],
    "tf_scale": 0.01,
    "goal_check_horizon": 1.0,
    "goal_check_hz": 25,
    "n_debug_trajectories": 25,
    "H_mpc": 5,
    "Q_diag": [10, 10, 10, 5, 5, 5],
    "R_diag": [10, 10, 0.05],
    "Qt_factor": 0
  },

  "shot_mpc": {
    "N": 20,
    "t_min": 0.05,
    "t_max": 1.0,
    "K": 2,
    "restitution": 1.0,
    "goal_margin": 0.01,
    "v_min": 0.2,
    "eps": 0.05,
    "delta": 0.01,
    "t_clear": 0.015,
    "t_react": 0.01,
    "t_ref": 0.5,
    "T_ref": 1.0,

    "weights": {
      "w_u": 1.0,
      "w_du": 0.1,
      "w_t": 1.0,
      "w_T": 1.0,
      "w_a": 1.0,
      "w_slack": 1000.0
    },

    "rates": {"outer_hz": 5, "inner_hz": 20},
    "t_commit": 0.15,
    "t_stop_replan": 0.06,
    "plan_expiry": 0.1,
    "contact_cooldown": 0.5,
    "sigma_init": 1.0,
    "n_tf_seeds": 1,

    "tracker": {
      "enabled": true,
      "H": 10,
      "theta_ref_world": 0.0,
      "Q": [1e4, 1e4, 1e2, 1e2, 1e2, 1.0],
      "Q_f": [1e6, 1e6, 1e2, 1e4, 1e4, 1.0],
      "R": [1.0, 1.0, 1.0]
    },

    "ipopt": {
      "max_iter": 40,
      "tol": 1e-4,
      "acceptable_tol": 1e-3,
      "valid_tol": 1e-3
    },
    "n_workers": 5
  },

  "forward": {
    "force": 0.05
  }
}
