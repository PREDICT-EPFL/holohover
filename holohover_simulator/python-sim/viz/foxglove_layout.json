    "StateTransitions!mode": {
      "foxglovePanelTitle": "Mode",
      "paths": [
        { "value": "/status.mode_name", "timestampMethod": "receiveTime" },
        { "value": "/shot_mpc/scores.chosen", "timestampMethod": "receiveTime" }
      ],
      "isSynced": true
    },
    "StateTransitions!compute": {
      "foxglovePanelTitle": "Compute (bar width = wall time)",
      "paths": [
        { "value": "/shot_mpc/compute/selector.state", "timestampMethod": "receiveTime", "label": "update" },
        { "value": "/shot_mpc/compute/direct.state", "timestampMethod": "receiveTime", "label": "direct" },
        { "value": "/shot_mpc/compute/L.state", "timestampMethod": "receiveTime", "label": "L" },
