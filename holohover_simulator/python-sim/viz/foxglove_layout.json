  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "direction": "row",
    "splitPercentage": 55,
    "first": "3D!table",
    "second": {
      "direction": "column",
      "splitPercentage": 50,
      "first": {
        "direction": "column",
        "splitPercentage": 50,
        "first": {
          "direction": "row",
          "splitPercentage": 50,
          "first": "Plot!robot1_velocity",
          "second": "Plot!puck_velocity"
        },
        "second": {
          "direction": "row",
          "splitPercentage": 50,
          "first": "Plot!robot1_force",
          "second": "Plot!sequence_scores"
        }
      },
      "second": {
        "direction": "column",
        "splitPercentage": 50,
        "first": {
          "direction": "row",
          "splitPercentage": 50,
          "first": "Plot!solve_time",
          "second": "StateTransitions!mode"
        },
        "second": {
          "direction": "column",
          "splitPercentage": 50,
          "first": "StateTransitions!compute",
          "second": {
            "direction": "row",
            "splitPercentage": 50,
            "first": "RosOut!events",
            "second": "RawMessages!solves"
          }
