    "RosOut!events": {
      "foxglovePanelTitle": "Events",
      "searchTerms": [],
      "minLogLevel": 1,
      "topicToRender": "/events"
    },
    "RawMessages!solves": {
      "foxglovePanelTitle": "Last selector update",
      "topicPath": "/shot_mpc/solves",
