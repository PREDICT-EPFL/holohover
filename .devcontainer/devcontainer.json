{
  "name": "holohover-python-sim",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/root/ros2_ws,type=bind,consistency=cached",
  "workspaceFolder": "/root/ros2_ws/holohover_simulator/python-sim",
  "runArgs": [
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python"
      }
    }
  }
}