# Holohover docker settings. Docker Compose loads this file automatically (docker/.env), so it is
# used by `./holohover <cmd>` and `docker compose -f docker/docker-compose.yml ...`.
# A variable exported in your shell overrides the value here, e.g. `ROS_DOMAIN_ID=5 ./holohover up`.

# ---------------------------------------------------------------------------------------------
# Build: passed as build args to docker/Dockerfile (changing them needs `./holohover build`)
# ---------------------------------------------------------------------------------------------
# ROS 2 distribution: base image osrf/ros:<distro>-desktop, ros-<distro>-* apt packages, /opt/ros/<distro>
ROS_DISTRO=lyrical

# Third-party C++ libraries built from source by docker/scripts/install_deps.sh (tag or commit).
# Empty = not installed.
# Logging library: holohover_dmpc
QUILL_VERSION=v4.4.1
# Optimization library: holohover_common, playground, dmpc.
CASADI_VERSION=a5852c23b2100296cee23b81227fcaa3bef43f04
# QP solver: holohover_common.
# Same commit as the Humble image (only the C++ library is built, no Python bindings)
PIQP_VERSION=a9e2cd91bb378223723cecf4ac8a628ef252fe04

# Colcon build options 
COLCON_WORKERS=2
MAKE_JOBS=2

# ---------------------------------------------------------------------------------------------
# Run: used by docker/docker-compose.yml when starting the containers
# ---------------------------------------------------------------------------------------------
# Image
HOLOHOVER_IMAGE=holohover-ws:${ROS_DISTRO}

# ROS 2 network
ROS_DOMAIN_ID=123
DISCOVERY_SERVER_IP=127.0.0.1
DISCOVERY_SERVER_PORT=11811

# Foxglove Studio to ws://<host>:<port>
FOXGLOVE_PORT=8765

# mocap_node parameters (path inside the container), used by `./holohover mocap start`
MOCAP_CONFIG=/root/ros2_ws/src/holohover/holohover_utils/config/optitrack/mocap_simple_config.yaml
