#!/usr/bin/env python3
# PYTHON_ARGCOMPLETE_OK
"""Helper to build and run the Holohover ROS 2 docker stack (see docker/)."""
import argparse
import os
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.realpath(__file__))
DOCKER_DIR = os.path.join(ROOT, "docker")
COMPOSE_FILE = os.path.join(DOCKER_DIR, "docker-compose.yml")
WORKSPACE = "workspace"
MOCAP = "mocap"
# Lets compose commands also see the optional mocap service (it is not started by `up`)
WITH_MOCAP = ["--profile", MOCAP]
SUBMODULES = ["holohover_mpc/external/laopt", "mocap_optitrack"]

DESCRIPTION = """\
Holohover docker tool: builds the ROS 2 workspace image and runs the stack.

The stack (docker/docker-compose.yml) starts three containers on the host network:
  holohover-discovery-server  Fast DDS discovery server (port 11811)
  holohover-foxglove-bridge   Foxglove bridge, connect Foxglove to ws://localhost:8765
  holohover                   workspace container where you run nodes/launch files
and, on demand with `./holohover mocap start`:
  holohover-mocap             OptiTrack mocap node, streams Motive data to ROS 2
"""

EPILOG = """\
getting started:
  ./holohover build           # build the image and compile the ROS 2 packages (first time takes a while)
  ./holohover up              # start discovery server, foxglove bridge and workspace
  ./holohover shell           # open a shell in the workspace (environment already sourced)
  ./holohover nodes           # list the running ROS 2 nodes
  ./holohover launch holohover_utils simulation_base.launch.py
  ./holohover mocap start     # (lab) check that Motive is streaming, then start the mocap node
  ./holohover down            # stop everything

notes:
  - The repository is mounted at /root/ros2_ws/src/holohover, so launch/config/python
    edits are live. After C++ changes run `./holohover colcon` to recompile in the running
    container (kept until the container is recreated), or `./holohover build` + `up` to bake it in.
  - Rosbags, ROS logs and shell history are stored in docker/data/ (/root/data in the container).
  - Settings (env vars or docker/.env): ROS_DOMAIN_ID (123), DISCOVERY_SERVER_IP (127.0.0.1),
    DISCOVERY_SERVER_PORT (11811), FOXGLOVE_PORT (8765), HOLOHOVER_IMAGE (holohover-ws:latest),
    MOCAP_CONFIG (container path of the mocap_node parameters, default
    /root/ros2_ws/src/holohover/holohover_utils/config/optitrack/mocap_config.yaml).

Run `./holohover <command> -h` for help on a single command.
"""


def docker_cmd():
    sock = "/var/run/docker.sock"
    if os.path.exists(sock) and not os.access(sock, os.W_OK):
        return ["sudo", "docker"]
    return ["docker"]


def compose(*args, check=True):
    cmd = docker_cmd() + ["compose", "-f", COMPOSE_FILE, *args]
    result = subprocess.run(cmd)
    if check and result.returncode != 0:
        sys.exit(result.returncode)
    return result.returncode


def is_running():
    cmd = docker_cmd() + ["compose", "-f", COMPOSE_FILE, "ps", "--status", "running", "-q", WORKSPACE]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout.strip()
    return bool(out)


def require_running():
    if not is_running():
        sys.exit("The holohover stack is not running, start it with `./holohover up`.")


def ws_exec(command, interactive=True):
    """Run a command in the workspace container with the ROS environment sourced."""
    require_running()
    flags = ["-it"] if interactive and sys.stdin.isatty() else []
    return compose("exec", *flags, WORKSPACE, "bash", "-c", "source /root/setup.bash && " + command, check=False)


def init_submodules():
    print("Initializing git submodules: " + ", ".join(SUBMODULES))
    subprocess.run(["git", "-C", ROOT, "submodule", "sync", "--quiet"])
    result = subprocess.run(["git", "-C", ROOT, "submodule", "update", "--init", *SUBMODULES])
    if result.returncode != 0:
        sys.exit("Failed to initialize the git submodules.")


def build_handler(args):
    if not args.skip_submodules:
        init_submodules()
    build_args = ["build"]
    if args.no_cache:
        build_args.append("--no-cache")
    if args.pull:
        build_args.append("--pull")
    compose(*build_args)
    if is_running():
        print("Image rebuilt, run `./holohover up` to recreate the running containers.")


def up_handler(args):
    os.makedirs(os.path.join(DOCKER_DIR, "data"), exist_ok=True)
    if os.environ.get("DISPLAY") and shutil.which("xhost"):
        subprocess.run(["xhost", "+local:root"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    compose("up", "-d")
    port = os.environ.get("FOXGLOVE_PORT", "8765")
    print(f"\nStack is up. Foxglove: ws://localhost:{port}   Shell: ./holohover shell")


def down_handler(args):
    compose(*WITH_MOCAP, "down")


def restart_handler(args):
    compose(*WITH_MOCAP, "restart", *args.services)


def status_handler(args):
    compose(*WITH_MOCAP, "ps")


def logs_handler(args):
    compose(*WITH_MOCAP, "logs", *(["-f"] if args.follow else []), *args.services, check=False)


def check_optitrack(timeout):
    """Listens on the OptiTrack multicast group (from MOCAP_CONFIG) in a one-off container."""
    return compose(*WITH_MOCAP, "run", "--rm", "--no-deps", MOCAP,
                   "bash", "-c", f'check-optitrack --timeout {timeout} --config "$MOCAP_CONFIG"', check=False)


def mocap_handler(args):
    if args.action == "check":
        sys.exit(check_optitrack(args.timeout))
    elif args.action == "start":
        if check_optitrack(args.timeout) != 0:
            if not args.force:
                sys.exit("Mocap node not started. Start Motive streaming and retry, or use --force to start it\n"
                         "anyway (it will wait until Motive streams).")
        compose(*WITH_MOCAP, "up", "-d", MOCAP)
        print("Mocap node started, check it with `./holohover logs -f mocap` and `./holohover topics`.")
    elif args.action == "stop":
        compose(*WITH_MOCAP, "stop", MOCAP)
        compose(*WITH_MOCAP, "rm", "-f", MOCAP)
    elif args.action == "logs":
        compose(*WITH_MOCAP, "logs", "-f", MOCAP, check=False)


def shell_handler(args):
    require_running()
    flags = ["-it"] if sys.stdin.isatty() else []
    compose("exec", *flags, WORKSPACE, "bash", check=False)


def exec_handler(args):
    if not args.cmd:
        sys.exit("Usage: ./holohover exec <command> [args...]")
    sys.exit(ws_exec(subprocess.list2cmdline(args.cmd)))


def nodes_handler(args):
    sys.exit(ws_exec("ros2 node list", interactive=False))


def topics_handler(args):
    sys.exit(ws_exec("ros2 topic list", interactive=False))


def launch_handler(args):
    sys.exit(ws_exec(subprocess.list2cmdline(["ros2", "launch", args.package, args.launch_file, *args.launch_args])))


def colcon_handler(args):
    colcon_args = args.colcon_args or ["build", "--symlink-install"]
    sys.exit(ws_exec("cd /root/ros2_ws && " + subprocess.list2cmdline(["colcon", *colcon_args])))


def main():
    parser = argparse.ArgumentParser(
        prog="./holohover",
        description=DESCRIPTION,
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", metavar="<command>")

    # build
    build_parser = subparsers.add_parser("build", help="Build the docker image and compile the ROS 2 packages")
    build_parser.add_argument("--no-cache", action="store_true", help="Rebuild every layer from scratch")
    build_parser.add_argument("--pull", action="store_true", help="Pull a newer version of the base ROS image")
    build_parser.add_argument("--skip-submodules", action="store_true", help="Do not run `git submodule update --init`")
    build_parser.set_defaults(func=build_handler)

    # up / down / restart / status / logs
    subparsers.add_parser("up", help="Start discovery server, foxglove bridge and workspace").set_defaults(func=up_handler)
    subparsers.add_parser("down", help="Stop and remove all holohover containers").set_defaults(func=down_handler)

    restart_parser = subparsers.add_parser("restart", help="Restart containers (all, or the given services)")
    restart_parser.add_argument("services", nargs="*", help="discovery-server, foxglove-bridge, workspace and/or mocap")
    restart_parser.set_defaults(func=restart_handler)

    subparsers.add_parser("status", help="Show the state of the containers").set_defaults(func=status_handler)

    logs_parser = subparsers.add_parser("logs", help="Show container logs")
    logs_parser.add_argument("-f", "--follow", action="store_true", help="Follow log output")
    logs_parser.add_argument("services", nargs="*", help="discovery-server, foxglove-bridge, workspace and/or mocap")
    logs_parser.set_defaults(func=logs_handler)

    # mocap
    mocap_parser = subparsers.add_parser(
        "mocap", help="OptiTrack mocap node: check | start | stop | logs",
        description="Manage the OptiTrack mocap node. `check` listens for Motive NatNet data on the multicast\n"
                    "group/port of MOCAP_CONFIG (holohover_utils/config/optitrack/mocap_config.yaml) and prints\n"
                    "the IP of the Motive PC. `start` runs the check first and only starts the node if Motive streams.",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    mocap_parser.add_argument("action", choices=["check", "start", "stop", "logs"], help="What to do")
    mocap_parser.add_argument("--timeout", type=float, default=5.0, help="Seconds to wait for Motive data (default 5)")
    mocap_parser.add_argument("--force", action="store_true", help="Start the node even if Motive is not streaming yet")
    mocap_parser.set_defaults(func=mocap_handler)

    # working inside the workspace container
    subparsers.add_parser("shell", help="Open a bash shell in the workspace container").set_defaults(func=shell_handler)

    exec_parser = subparsers.add_parser("exec", help="Run a command in the workspace container (ROS sourced)")
    exec_parser.add_argument("cmd", nargs=argparse.REMAINDER, help="Command and arguments, e.g. ros2 topic echo /clock")
    exec_parser.set_defaults(func=exec_handler)

    subparsers.add_parser("nodes", help="List the running ROS 2 nodes").set_defaults(func=nodes_handler)
    subparsers.add_parser("topics", help="List the available ROS 2 topics").set_defaults(func=topics_handler)

    launch_parser = subparsers.add_parser("launch", help="Run `ros2 launch` in the workspace container")
    launch_parser.add_argument("package", help="Package name, e.g. holohover_utils")
    launch_parser.add_argument("launch_file", help="Launch file, e.g. simulation_base.launch.py")
    launch_parser.add_argument("launch_args", nargs=argparse.REMAINDER, help="Launch arguments, e.g. name:=value")
    launch_parser.set_defaults(func=launch_handler)

    colcon_parser = subparsers.add_parser(
        "colcon", help="Recompile inside the running workspace (default: colcon build --symlink-install)")
    colcon_parser.add_argument("colcon_args", nargs=argparse.REMAINDER,
                               help="colcon arguments, e.g. build --symlink-install --packages-select holohover_mpc")
    colcon_parser.set_defaults(func=colcon_handler)

    try:
        import argcomplete
        argcomplete.autocomplete(parser)
    except ImportError:
        pass

    args = parser.parse_args()
    if hasattr(args, "func"):
        args.func(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
