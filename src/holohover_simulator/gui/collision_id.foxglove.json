  "userNodes": {
    "holohover-air-hockey-scene": {
      "name": "air hockey scene (no planner)",
      "sourceCode": "// No-planner variant (LQR / collision identification / puck only): reads only /h3/state and /puck/state,\n// since Foxglove does not run a script while one of its inputs is missing. The table is drawn with either.\n// Air hockey scene for live runs and recordings, frame \"world\" (= table frame, origin at the centre):\n// the table, its goal mouths and midline, h3 and the puck from their EKF states, and h3's plans\n// (holohover_msgs/HolohoverPlan): for every valid candidate its planned path, its predicted shot\n// (straight, with side-wall reflections, up to an end wall) and its label and cost; the chosen one in\n// full colour with the robot and the puck at the impact, the others faint. No candidate clears them.\n// Each message updates its own entities; the table is redrawn with every h3 state, so it is there\n// right after a seek in a recording.\nimport { Input } from \"./types\";\nimport {\n  SceneUpdate,\n  SceneEntity,\n  LinePrimitive,\n  CylinderPrimitive,\n  TextPrimitive,\n  Color,\n  Point3,\n} from \"@foxglove/schemas\";\n\ntype Time = { sec: number; nsec: number };\n\nexport const inputs = [\"/h3/state\", \"/puck/state\"];\nexport const output = \"/studio_script/air_hockey\";\n\n// Table and bodies: shot_planner_config.yaml\nconst WIDTH = 2.204,\n  HEIGHT = 1.102,\n  GOAL_WIDTH = 0.34,\n  R_ROBOT = 0.07,\n  R_PUCK = 0.035;\n\nconst identity = { x: 0, y: 0, z: 0, w: 1 };\nconst pose = { position: { x: 0, y: 0, z: 0 }, orientation: identity };\nconst rgba = (r: number, g: number, b: number, a = 1): Color => ({\n  r,\n  g,\n  b,\n  a,\n});\nconst pt = (x: number, y: number, z = 0.02): Point3 => ({ x, y, z });\n\nconst ROBOT = rgba(0.2, 0.6, 1),\n  PUCK = rgba(1, 0.85, 0.2),\n  WALL = rgba(0.85, 0.85, 0.85),\n  GOAL = rgba(1, 0.2, 0.2);\n\nfunction line(\n  points: Point3[],\n  color: Color,\n  thickness = 0.008,\n): LinePrimitive {\n  return {\n    type: 0,\n    pose,\n    thickness,\n    scale_invariant: false,\n    points,\n    color,\n    colors: [],\n    indices: [],\n  };\n}\n\nfunction disc(\n  x: number,\n  y: number,\n  radius: number,\n  color: Color,\n  z = 0.01,\n): CylinderPrimitive {\n  return {\n    pose: { position: { x, y, z }, orientation: identity },\n    size: { x: 2 * radius, y: 2 * radius, z: 0.02 },\n    bottom_scale: 1,\n    top_scale: 1,\n    color,\n  };\n}\n\nfunction text(p: Point3, s: string, color: Color): TextPrimitive {\n  return {\n    pose: { position: p, orientation: identity },\n    billboard: true,\n    font_size: 12,\n    scale_invariant: true,\n    color,\n    text: s,\n  };\n}\n\nfunction entity(\n  timestamp: Time,\n  id: string,\n  lines: LinePrimitive[],\n  cylinders: CylinderPrimitive[] = [],\n  texts: TextPrimitive[] = [],\n): SceneEntity {\n  return {\n    timestamp,\n    frame_id: \"world\",\n    id,\n    lifetime: { sec: 0, nsec: 0 },\n    frame_locked: false,\n    metadata: [],\n    arrows: [],\n    cubes: [],\n    spheres: [],\n    cylinders,\n    lines,\n    triangles: [],\n    texts,\n    models: [],\n  };\n}\n\nfunction table(ts: Time): SceneEntity {\n  const x = WIDTH / 2,\n    y = HEIGHT / 2,\n    g = GOAL_WIDTH / 2;\n  return entity(ts, \"table\", [\n    line([pt(-x, -y), pt(x, -y), pt(x, y), pt(-x, y), pt(-x, -y)], WALL, 0.01),\n    line([pt(0, -y), pt(0, y)], rgba(0.85, 0.85, 0.85, 0.4), 0.004),\n    line([pt(-x, -g), pt(-x, g)], GOAL, 0.025),\n    line([pt(x, -g), pt(x, g)], GOAL, 0.025),\n  ]);\n}\n\n// Straight puck path from p along v, reflected on the side walls, up to an end wall\nfunction shot(px: number, py: number, vx: number, vy: number): Point3[] {\n  const xw = WIDTH / 2 - R_PUCK,\n    yw = HEIGHT / 2 - R_PUCK;\n  const points = [pt(px, py)];\n  for (let i = 0; i < 6 && (vx !== 0 || vy !== 0); i++) {\n    const tx = vx !== 0 ? ((vx > 0 ? xw : -xw) - px) / vx : Infinity;\n    const ty = vy !== 0 ? ((vy > 0 ? yw : -yw) - py) / vy : Infinity;\n    const t = Math.max(0, Math.min(tx, ty));\n    px += vx * t;\n    py += vy * t;\n    points.push(pt(px, py));\n    if (tx <= ty) break; // end wall\n    vy = -vy;\n  }\n  return points;\n}\n\nexport default function script(\n  event: Input<\"/h3/state\"> | Input<\"/puck/state\">,\n): SceneUpdate {\n  const ts = event.receiveTime;\n  const s = event.message.state_msg;\n  if (event.topic === \"/h3/state\") {\n    const heading = [\n      pt(s.x, s.y, 0.03),\n      pt(\n        s.x + R_ROBOT * Math.cos(s.yaw),\n        s.y + R_ROBOT * Math.sin(s.yaw),\n        0.03,\n      ),\n    ];\n    return {\n      deletions: [],\n      entities: [\n        table(ts),\n        entity(\n          ts,\n          \"h3\",\n          [line(heading, rgba(1, 1, 1), 0.01)],\n          [disc(s.x, s.y, R_ROBOT, ROBOT)],\n        ),\n      ],\n    };\n  }\n  return {\n    deletions: [],\n    entities: [table(ts), entity(ts, \"puck\", [], [disc(s.x, s.y, R_PUCK, PUCK)])],\n  };\n}\n"
    }
  },
  "playbackConfig": {
    "speed": 1
  },
  "layout": "Tab!main"
}