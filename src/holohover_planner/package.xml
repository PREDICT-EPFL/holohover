<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>holohover_planner</name>
  <version>0.0.0</version>
  <description>Planners of the holohover: the shot MPC planner, publishing HolohoverPlan for a controller</description>
  <maintainer email="alexis.bollack@gmail.com">Alexis Bollack</maintainer>
  <license>BSD-2-Clause</license>

  <depend>rclpy</depend>
  <depend>holohover_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Python packages from pip (requirements.txt, installed by docker/Dockerfile): casadi -->
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
