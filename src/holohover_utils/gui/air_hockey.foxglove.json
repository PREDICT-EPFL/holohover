  "userNodes": {
    "holohover-air-hockey-scene": {
      "name": "air hockey scene",
      "sourceCode": "// Air hockey scene for live runs and recordings, frame \"world\" (= table frame, origin at the centre):\n// the table, its goal mouths and midline, h0 and the puck from their EKF states, and h0's plans\n// (holohover_msgs/HolohoverPlan): for every valid candidate its planned path, its predicted shot\n// (straight, with side-wall bounces, up to an end wall) and its label and cost; the chosen one in\n// full colour with the robot and the puck at the impact, the others faint. No candidate clears them.\n// Each message updates its own entities; the table is redrawn with every h0 state, so it is there\n// right after a seek in a recording.\nimport { Input } from \"./types\";\nimport { SceneUpdate, SceneEntity, LinePrimitive, CylinderPrimitive, TextPrimitive, Color, Point3 } from \"@foxglove/schemas\";\n\ntype Time = { sec: number; nsec: number };\n\nexport const inputs = [\"/h0/state\", \"/puck/state\", \"/h0/plan\"];\nexport const output = \"/studio_script/air_hockey\";\n\n// Table and bodies: shot_planner_config.yaml (E_WALL: table.restitution; python-sim's walls are elastic)\nconst WIDTH = 2.13, HEIGHT = 1.06, GOAL_WIDTH = 0.34, R_ROBOT = 0.07, R_PUCK = 0.035, E_WALL = 0.9;\n// The walls' faces, inside the table edges: table.wall_inset (the Box2D walls' skin)\nconst INSET = 0.0105;\n\nconst identity = { x: 0, y: 0, z: 0, w: 1 };\nconst pose = { position: { x: 0, y: 0, z: 0 }, orientation: identity };\nconst rgba = (r: number, g: number, b: number, a = 1): Color => ({ r, g, b, a });\nconst pt = (x: number, y: number, z = 0.02): Point3 => ({ x, y, z });\n\nconst ROBOT = rgba(0.2, 0.6, 1), PUCK = rgba(1, 0.85, 0.2), WALL = rgba(0.85, 0.85, 0.85), GOAL = rgba(1, 0.2, 0.2);\n\nfunction line(points: Point3[], color: Color, thickness = 0.008): LinePrimitive {\n  return { type: 0, pose, thickness, scale_invariant: false, points, color, colors: [], indices: [] };\n}\n\nfunction disc(x: number, y: number, radius: number, color: Color, z = 0.01): CylinderPrimitive {\n  return { pose: { position: { x, y, z }, orientation: identity },\n           size: { x: 2 * radius, y: 2 * radius, z: 0.02 }, bottom_scale: 1, top_scale: 1, color };\n}\n\nfunction text(p: Point3, s: string, color: Color): TextPrimitive {\n  return { pose: { position: p, orientation: identity }, billboard: true, font_size: 12, scale_invariant: true,\n           color, text: s };\n}\n\nfunction entity(timestamp: Time, id: string, lines: LinePrimitive[], cylinders: CylinderPrimitive[] = [],\n                texts: TextPrimitive[] = []): SceneEntity {\n  return { timestamp, frame_id: \"world\", id, lifetime: { sec: 0, nsec: 0 }, frame_locked: false, metadata: [],\n           arrows: [], cubes: [], spheres: [], cylinders, lines, triangles: [], texts, models: [] };\n}\n\nfunction table(ts: Time): SceneEntity {\n  const x = WIDTH / 2, y = HEIGHT / 2, g = GOAL_WIDTH / 2;\n  return entity(ts, \"table\", [\n    line([pt(-x, -y), pt(x, -y), pt(x, y), pt(-x, y), pt(-x, -y)], WALL, 0.01),\n    line([pt(0, -y), pt(0, y)], rgba(0.85, 0.85, 0.85, 0.4), 0.004),\n    line([pt(-x, -g), pt(-x, g)], GOAL, 0.025),\n    line([pt(x, -g), pt(x, g)], GOAL, 0.025),\n  ]);\n}\n\n// Puck path from p along v, bouncing on the side walls (v_y reversed, scaled by E_WALL), up to an end wall\nfunction shot(px: number, py: number, vx: number, vy: number): Point3[] {\n  const xw = WIDTH / 2 - INSET - R_PUCK, yw = HEIGHT / 2 - INSET - R_PUCK;\n  const points = [pt(px, py)];\n  for (let i = 0; i < 6 && (vx !== 0 || vy !== 0); i++) {\n    const tx = vx !== 0 ? ((vx > 0 ? xw : -xw) - px) / vx : Infinity;\n    const ty = vy !== 0 ? ((vy > 0 ? yw : -yw) - py) / vy : Infinity;\n    const t = Math.max(0, Math.min(tx, ty));\n    px += vx * t;\n    py += vy * t;\n    points.push(pt(px, py));\n    if (tx <= ty) break;  // end wall\n    vy = -E_WALL * vy;\n  }\n  return points;\n}\n\nexport default function script(\n  event: Input<\"/h0/state\"> | Input<\"/puck/state\"> | Input<\"/h0/plan\">,\n): SceneUpdate {\n  const ts = event.receiveTime;\n  if (event.topic === \"/h0/state\") {\n    const s = event.message.state_msg;\n    const heading = [pt(s.x, s.y, 0.03), pt(s.x + R_ROBOT * Math.cos(s.yaw), s.y + R_ROBOT * Math.sin(s.yaw), 0.03)];\n    return { deletions: [], entities: [table(ts), entity(ts, \"h0\", [line(heading, rgba(1, 1, 1), 0.01)],\n                                                         [disc(s.x, s.y, R_ROBOT, ROBOT)])] };\n  }\n  if (event.topic === \"/puck/state\") {\n    const s = event.message.state_msg;\n    // line from the centre to the edge along the yaw: shows the spin\n    const mark = [pt(s.x, s.y, 0.03), pt(s.x + R_PUCK * Math.cos(s.yaw), s.y + R_PUCK * Math.sin(s.yaw), 0.03)];\n    return { deletions: [], entities: [entity(ts, \"puck\", [line(mark, rgba(0.1, 0.1, 0.1), 0.006)],\n                                                          [disc(s.x, s.y, R_PUCK, PUCK)])] };\n  }\n  const msg = event.message;\n  const lines: LinePrimitive[] = [], cylinders: CylinderPrimitive[] = [], texts: TextPrimitive[] = [];\n  msg.candidates.forEach((c, i) => {\n    if (c.states.length === 0) return;  // no valid plan for this sequence\n    const chosen = i === msg.chosen;\n    const alpha = chosen ? 1 : 0.3, width = chosen ? 0.008 : 0.004;\n    const path = shot(c.impact_puck.x, c.impact_puck.y, c.puck_velocity.x, c.puck_velocity.y);\n    lines.push(line(c.states.map((s) => pt(s.x, s.y, 0.005)), rgba(0.2, 0.6, 1, alpha), width));\n    lines.push(line(path, rgba(1, 0.85, 0.2, alpha), width));\n    const tip = path[path.length - 1];\n    texts.push(text(pt(tip.x, tip.y, 0.05), `${c.label} ${c.cost.toFixed(2)}`, rgba(1, 1, 1, chosen ? 1 : 0.6)));\n    if (chosen) {\n      const end = c.states[c.states.length - 1];\n      cylinders.push(disc(end.x, end.y, R_ROBOT, rgba(0.2, 0.6, 1, 0.3), 0.0),\n                     disc(c.impact_puck.x, c.impact_puck.y, R_PUCK, rgba(1, 0.85, 0.2, 0.4), 0.0));\n    }\n  });\n  if (lines.length === 0) {\n    return { deletions: [{ timestamp: ts, type: 0, id: \"plan\" }], entities: [] };\n  }\n  return { deletions: [], entities: [entity(ts, \"plan\", lines, cylinders, texts)] };\n}\n"
    }
  },
  "playbackConfig": {
    "speed": 1
  },
  "layout": "Tab!main"
}