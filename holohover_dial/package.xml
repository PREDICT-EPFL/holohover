<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>holohover_dial</name>
  <version>0.0.0</version>
  <description>Diffusion Inspired Annealing (DIAL) for Holohover control and Puck shooting</description>
  <maintainer email="till.beyer@epfl.ch">till</maintainer>
  <license>Apache-2.0</license>

  <!-- ROS2 core dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>holohover_msgs</depend>
  
  <!-- Python package dependencies -->
  <depend>numpy</depend>

  <!-- Testing dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
